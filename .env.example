ENVIRONMENT="development"
LOG_LEVEL="trace"
WEB_SERVER_PORT=8000

DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="boilerplate"
DATABASE_SSL_MODE="disable"
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_CONN_MAX_LIFETIME_SECS=300
DATABASE_CONN_MAX_IDLE_TIME_SECS=300

ACCESS_TOKEN_SECRET="change-me-access-secret"
ACCESS_TOKEN_LIFETIME_MINUTES=60 # 1 hour
REFRESH_TOKEN_SECRET="change-me-refresh-secret"
REFRESH_TOKEN_LIFETIME_MINUTES=1440 # 24 hours
TOKEN_ISSUER="go-api-boilerplate"
TOKEN_AUDIENCE="go-api-boilerplate-clients"

MAILER_SENDER_NAME="Go API Boilerplate"
MAILER_SENDER_EMAIL="no-reply@example.com"

ACCOUNT_CONFIRMATION_BASE_URL="http://localhost:3000/confirm-account"
PASSWORD_RECOVERY_BASE_URL="http://localhost:3000/reset-password"

CORS_ALLOWED_ORIGINS="http://localhost:3000"

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
